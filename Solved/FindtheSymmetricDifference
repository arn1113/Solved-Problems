function sym(...arrays) {
  // Helper: symmetric difference of two sets
  const diff = (a, b) => {
    const setA = new Set(a);
    const setB = new Set(b);

    const result = new Set();

    for (let val of setA) {
      if (!setB.has(val)) result.add(val);
    }
    for (let val of setB) {
      if (!setA.has(val)) result.add(val);
    }

    return [...result];
  };

  // Reduce pairwise because △ is binary
  return arrays.reduce((acc, arr) => diff(acc, arr), []);
}
